// ============================================================
// PHASE 1: CORE ACCOUNTING MODELS
// ============================================================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String
  firstName      String
  lastName       String
  role           Role      @default(VIEWER)
  refreshToken   String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  journalEntries JournalEntry[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  twoFactorAuth  TwoFactorAuth?
  activeSessions ActiveSession[]
  apiKeys        ApiKey[]
  securityEvents SecurityEvent[]
  auditLogs      AuditLog[]
  mobileDevices  MobileDevice[]
  notifications  Notification[]
  notificationPreferences NotificationPreference[]

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

model Organization {
  id          String    @id @default(cuid())
  name        String
  inn         String    @unique
  address     String?
  phone       String?
  email       String?
  bankAccount String?
  mfo         String?
  oked        String?
  director    String?
  accountant  String?
  settings    Json?
  users       User[]
  accounts    Account[]
  journalEntries JournalEntry[]
  transactions Transaction[]
  counterparties Counterparty[]
  orgSettings Settings[]
  taxPeriods  TaxPeriod[]
  taxReports  TaxReport[]
  vatEntries  VatEntry[]
  profitTaxReports ProfitTaxReport[]
  didoxDocuments DidoxDocument[]
  didoxConfig DidoxConfig?
  inpsRecords InpsRecord[]
  ndflRecords NdflRecord[]
  soliqSubmissions SoliqSubmission[]
  soliqConfig SoliqConfig?
  invoices    Invoice[]
  employees   Employee[]
  departments Department[]
  positions   Position[]
  payrolls    Payroll[]
  timesheets  Timesheet[]
  hrDocuments HrDocument[]
  staffSchedules StaffSchedule[]
  products    Product[]
  productCategories ProductCategory[]
  warehouses  Warehouse[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  salesOrders SalesOrder[]
  inventoryChecks InventoryCheck[]
  contracts   Contract[]
  receivables Receivable[]
  payables    Payable[]
  bankAccounts BankAccount[]
  bankStatements BankStatement[]
  bankReconciliations BankReconciliation[]
  paymentGateways PaymentGateway[]
  onlinePayments OnlinePayment[]
  paymentSchedules PaymentSchedule[]
  cashOrders  CashOrder[]
  cashRegisters CashRegister[]
  financialReports FinancialReport[]
  cashFlowReports CashFlowReport[]
  kpiTargets  KpiTarget[]
  fixedAssets FixedAsset[]
  consolidationReports ConsolidationReport[]
  currencyRates CurrencyRate[]
  exportHistory ExportHistory[]
  countryPlugins CountryPlugin[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("organizations")
}

model Account {
  id             String    @id @default(cuid())
  code           String
  name           String
  nameRu         String?
  nameEn         String?
  type           AccountType
  parentId       String?
  parent         Account?  @relation("AccountTree", fields: [parentId], references: [id])
  children       Account[] @relation("AccountTree")
  isActive       Boolean   @default(true)
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  debitLines     JournalLine[] @relation("DebitAccount")
  creditLines    JournalLine[] @relation("CreditAccount")
  transactions   Transaction[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([code, organizationId])
  @@index([organizationId])
  @@index([type])
  @@map("accounts")
}

model JournalEntry {
  id             String    @id @default(cuid())
  number         String
  date           DateTime
  description    String
  reference      String?
  status         JournalStatus @default(DRAFT)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  lines          JournalLine[]
  transactions   Transaction[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([date])
  @@index([status])
  @@map("journal_entries")
}

model JournalLine {
  id             String    @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account  @relation("DebitAccount", fields: [accountId], references: [id])
  creditAccountId String?
  creditAccount  Account? @relation("CreditAccount", fields: [creditAccountId], references: [id])
  debit          Decimal   @default(0) @db.Decimal(18, 2)
  credit         Decimal   @default(0) @db.Decimal(18, 2)
  description    String?
  createdAt      DateTime  @default(now())

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model Transaction {
  id             String    @id @default(cuid())
  type           TransactionType
  amount         Decimal   @db.Decimal(18, 2)
  date           DateTime
  description    String
  reference      String?
  counterpartyId String?
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id])
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([type])
  @@index([date])
  @@map("transactions")
}

model Counterparty {
  id             String    @id @default(cuid())
  name           String
  type           CounterpartyType
  inn            String?
  phone          String?
  email          String?
  address        String?
  bankAccount    String?
  mfo            String?
  contactPerson  String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  transactions   Transaction[]
  invoices       Invoice[]
  contracts      Contract[]
  receivables    Receivable[]
  payables       Payable[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([type])
  @@map("counterparties")
}

model Settings {
  id             String    @id @default(cuid())
  key            String
  value          Json
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([key, organizationId])
  @@map("settings")
}

// ============================================================
// PHASE 2: TAX & COMPLIANCE MODELS
// ============================================================

model TaxPeriod {
  id             String    @id @default(cuid())
  type           TaxType
  periodType     TaxPeriodType
  year           Int
  quarter        Int?
  month          Int?
  startDate      DateTime
  endDate        DateTime
  deadline       DateTime
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  reports        TaxReport[]
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@map("tax_periods")
}

model TaxReport {
  id             String    @id @default(cuid())
  taxPeriodId    String
  taxPeriod      TaxPeriod @relation(fields: [taxPeriodId], references: [id])
  status         TaxReportStatus @default(DRAFT)
  totalAmount    Decimal   @db.Decimal(18, 2)
  paidAmount     Decimal   @default(0) @db.Decimal(18, 2)
  data           Json?
  submittedAt    DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@map("tax_reports")
}

model VatEntry {
  id             String    @id @default(cuid())
  type           VatEntryType
  invoiceNumber  String?
  invoiceDate    DateTime?
  counterpartyName String?
  counterpartyInn String?
  amount         Decimal   @db.Decimal(18, 2)
  vatAmount      Decimal   @db.Decimal(18, 2)
  vatRate        Decimal   @default(12) @db.Decimal(5, 2)
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([type])
  @@map("vat_entries")
}

model ProfitTaxReport {
  id             String    @id @default(cuid())
  year           Int
  quarter        Int
  revenue        Decimal   @db.Decimal(18, 2)
  expenses       Decimal   @db.Decimal(18, 2)
  taxableProfit  Decimal   @db.Decimal(18, 2)
  taxRate        Decimal   @default(15) @db.Decimal(5, 2)
  taxAmount      Decimal   @db.Decimal(18, 2)
  status         TaxReportStatus @default(DRAFT)
  data           Json?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@map("profit_tax_reports")
}

model DidoxDocument {
  id             String    @id @default(cuid())
  externalId     String?
  type           DidoxDocumentType
  status         DidoxDocumentStatus @default(DRAFT)
  number         String
  date           DateTime
  counterpartyInn String?
  counterpartyName String?
  totalAmount    Decimal   @db.Decimal(18, 2)
  vatAmount      Decimal   @db.Decimal(18, 2)
  data           Json?
  sentAt         DateTime?
  acceptedAt     DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([status])
  @@map("didox_documents")
}

model DidoxConfig {
  id             String    @id @default(cuid())
  apiKey         String
  companyTin     String
  apiUrl         String    @default("https://api.didox.uz")
  autoSend       Boolean   @default(false)
  organizationId String    @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("didox_configs")
}

model InpsRecord {
  id             String    @id @default(cuid())
  employeeId     String?
  employeeName   String
  year           Int
  month          Int
  baseSalary     Decimal   @db.Decimal(18, 2)
  inpsRate       Decimal   @default(12) @db.Decimal(5, 2)
  inpsAmount     Decimal   @db.Decimal(18, 2)
  status         InpsStatus @default(DRAFT)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@map("inps_records")
}

model NdflRecord {
  id             String    @id @default(cuid())
  employeeId     String?
  employeeName   String
  year           Int
  month          Int
  grossIncome    Decimal   @db.Decimal(18, 2)
  deductions     Decimal   @default(0) @db.Decimal(18, 2)
  taxableIncome  Decimal   @db.Decimal(18, 2)
  ndflRate       Decimal   @default(12) @db.Decimal(5, 2)
  ndflAmount     Decimal   @db.Decimal(18, 2)
  status         NdflStatus @default(DRAFT)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  ndflDeductions NdflDeduction[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@map("ndfl_records")
}

model NdflDeduction {
  id           String    @id @default(cuid())
  ndflRecordId String
  ndflRecord   NdflRecord @relation(fields: [ndflRecordId], references: [id], onDelete: Cascade)
  type         NdflDeductionType
  amount       Decimal   @db.Decimal(18, 2)
  description  String?
  createdAt    DateTime  @default(now())

  @@map("ndfl_deductions")
}

model SoliqSubmission {
  id             String    @id @default(cuid())
  reportType     SoliqReportType
  year           Int
  quarter        Int?
  month          Int?
  status         SoliqSubmissionStatus @default(DRAFT)
  xmlData        String?   @db.Text
  signedData     String?   @db.Text
  responseData   Json?
  submittedAt    DateTime?
  acceptedAt     DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@map("soliq_submissions")
}

model SoliqConfig {
  id             String    @id @default(cuid())
  apiKey         String?
  eriCertPath    String?
  eriCertPassword String?
  autoSubmit     Boolean   @default(false)
  organizationId String    @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("soliq_configs")
}

model Invoice {
  id             String    @id @default(cuid())
  number         String
  date           DateTime
  dueDate        DateTime?
  status         InvoiceStatus @default(DRAFT)
  counterpartyId String
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id])
  subtotal       Decimal   @db.Decimal(18, 2)
  vatRate        Decimal   @default(12) @db.Decimal(5, 2)
  vatAmount      Decimal   @db.Decimal(18, 2)
  totalAmount    Decimal   @db.Decimal(18, 2)
  notes          String?
  items          InvoiceItem[]
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([counterpartyId])
  @@map("invoices")
}

model InvoiceItem {
  id          String    @id @default(cuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productName String
  quantity    Decimal   @db.Decimal(18, 3)
  unitPrice   Decimal   @db.Decimal(18, 2)
  amount      Decimal   @db.Decimal(18, 2)
  vatAmount   Decimal   @db.Decimal(18, 2)
  unit        String?

  @@map("invoice_items")
}

// ============================================================
// PHASE 3: HR & PAYROLL MODELS
// ============================================================

model Employee {
  id             String    @id @default(cuid())
  tabNumber      String
  firstName      String
  lastName       String
  middleName     String?
  birthDate      DateTime?
  phone          String?
  email          String?
  address        String?
  passportSeries String?
  passportNumber String?
  inn            String?
  inps           String?
  hireDate       DateTime
  dismissDate    DateTime?
  status         EmployeeStatus @default(ACTIVE)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  positionId     String?
  position       Position? @relation(fields: [positionId], references: [id])
  baseSalary     Decimal   @db.Decimal(18, 2)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  payrollItems   PayrollItem[]
  timesheetEntries TimesheetEntry[]
  hrDocuments    HrDocument[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tabNumber, organizationId])
  @@index([organizationId])
  @@index([departmentId])
  @@map("employees")
}

model Department {
  id             String    @id @default(cuid())
  name           String
  code           String?
  parentId       String?
  parent         Department? @relation("DepartmentTree", fields: [parentId], references: [id])
  children       Department[] @relation("DepartmentTree")
  managerId      String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employees      Employee[]
  positions      Position[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@map("departments")
}

model Position {
  id             String    @id @default(cuid())
  name           String
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  grade          Int?
  minSalary      Decimal?  @db.Decimal(18, 2)
  maxSalary      Decimal?  @db.Decimal(18, 2)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employees      Employee[]
  staffSchedules StaffSchedule[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@map("positions")
}

model Payroll {
  id             String    @id @default(cuid())
  number         String
  year           Int
  month          Int
  status         PayrollStatus @default(DRAFT)
  totalGross     Decimal   @db.Decimal(18, 2)
  totalDeductions Decimal  @db.Decimal(18, 2)
  totalNet       Decimal   @db.Decimal(18, 2)
  items          PayrollItem[]
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@map("payrolls")
}

model PayrollItem {
  id           String    @id @default(cuid())
  payrollId    String
  payroll      Payroll   @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  baseSalary   Decimal   @db.Decimal(18, 2)
  bonus        Decimal   @default(0) @db.Decimal(18, 2)
  overtime     Decimal   @default(0) @db.Decimal(18, 2)
  grossSalary  Decimal   @db.Decimal(18, 2)
  ndfl         Decimal   @db.Decimal(18, 2)
  inps         Decimal   @db.Decimal(18, 2)
  otherDeductions Decimal @default(0) @db.Decimal(18, 2)
  netSalary    Decimal   @db.Decimal(18, 2)

  @@map("payroll_items")
}

model Timesheet {
