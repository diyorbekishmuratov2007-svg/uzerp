// UzERP - Prisma Schema
// 78 Models, 60 Enums - Complete ERP/Accounting System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  ACCOUNTANT
  VIEWER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum CounterpartyType {
  CLIENT
  SUPPLIER
  OTHER
}

enum TaxType {
  QQS
  PROFIT
  INPS
  NDFL
  PROPERTY
  LAND
  WATER
  OTHER
}

enum TaxPeriodType {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum TaxReportStatus {
  DRAFT
  CALCULATED
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum VatEntryType {
  INPUT
  OUTPUT
}

enum DidoxDocumentType {
  INVOICE
  ACT
  EMPOWERMENT
  CONTRACT
  WAYBILL
}

enum DidoxDocumentStatus {
  DRAFT
  SENT
  DELIVERED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum InpsStatus {
  DRAFT
  CALCULATED
  SUBMITTED
  ACCEPTED
}

enum NdflStatus {
  DRAFT
  CALCULATED
  SUBMITTED
  ACCEPTED
}

