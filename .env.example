# ===========================================
# UzERP - Environment Variables
# ===========================================

# Database
DATABASE_URL=postgresql://uzerp:uzerp_secret@localhost:5432/uzerp?schema=public
POSTGRES_USER=uzerp
POSTGRES_PASSWORD=uzerp_secret
POSTGRES_DB=uzerp

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API Configuration
API_PORT=3001
API_PREFIX=/api
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_NAME=UzERP
NEXT_PUBLIC_DEFAULT_LOCALE=uz

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE=UzERP API
SWAGGER_DESCRIPTION=UzERP ERP/Buxgalteriya tizimi API
SWAGGER_VERSION=1.0

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Didox Integration
DIDOX_API_URL=https://api.didox.uz
DIDOX_API_KEY=your-didox-api-key
DIDOX_COMPANY_TIN=123456789

# Soliq.uz Integration
SOLIQ_API_URL=https://api.soliq.uz
SOLIQ_API_KEY=your-soliq-api-key
SOLIQ_ERI_CERT_PATH=./certs/eri.pfx
SOLIQ_ERI_CERT_PASSWORD=cert-password

# Payment Gateways
PAYME_MERCHANT_ID=your-payme-merchant-id
PAYME_SECRET_KEY=your-payme-secret
CLICK_MERCHANT_ID=your-click-merchant-id
CLICK_SECRET_KEY=your-click-secret
CLICK_SERVICE_ID=your-click-service-id
UZUM_MERCHANT_ID=your-uzum-merchant-id
UZUM_SECRET_KEY=your-uzum-secret

# AI Features
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
AI_MODEL=gpt-4

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY=your-firebase-key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@project.iam.gserviceaccount.com

# CBU (Central Bank of Uzbekistan) Currency Rates
CBU_API_URL=https://cbu.uz/uz/arkhiv-kursov-valyut/json/

# Security
BCRYPT_ROUNDS=12
TWO_FACTOR_APP_NAME=UzERP
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
